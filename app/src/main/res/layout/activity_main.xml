<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#5F9EA0"
    android:id="@+id/main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imageZdjecie"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:contentDescription="Zdjęcie osoby"
            android:src="@drawable/zdjecia0"/>

        <ImageView
            android:id="@+id/imageOdcisk"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:scaleType="centerCrop"
            android:contentDescription="Odcisk palca"
            android:src="@drawable/odcisk0"/>



    </LinearLayout>
    <Button
        android:id="@+id/buttonOk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="OK"
        android:backgroundTint="#F0FFFF"
        android:textColor="#000000" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Numer"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/editNumer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:backgroundTint="#F0FFFF" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Imię"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/editImie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textPersonName"
                android:backgroundTint="#F0FFFF" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Nazwisko"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/editNazwisko"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textPersonName"
                android:backgroundTint="#F0FFFF" />

        </LinearLayout>

    </LinearLayout>

    <RadioGroup
        android:id="@+id/radioGroupKolorOczu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kolor oczu"
            android:textStyle="bold"
            android:textColor="#000000" />

        <RadioButton
            android:id="@+id/radioNiebieskie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="niebieskie"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioZielone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="zielone" />

        <RadioButton
            android:id="@+id/radioPiwne"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="piwne" />

    </RadioGroup>

    <TextView
        android:id="@+id/log_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

</LinearLayout>
